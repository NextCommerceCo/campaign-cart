{
  "name": "@nextcommerce/campaign-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "NEXT Campaign SDK: one headless Engine, everything else subscribes",
  "type": "module",
  "scripts": {
    "dev": "bun dev/server.ts",
    "build": "vite build && node scripts/size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
