{
  "name": "@NextCommerce/campaign-cart",
  "version": "0.4.31",
  "description": "Modern TypeScript SDK for NextCommerce Campaign Cart integration with progressive enhancement via data attributes",
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./styles": "./dist/campaign-cart.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/html-custom-data.json"
  ],
  "scripts": {
    "dev": "vite",
    "dev:serve": "vite serve dev.html",
    "dev:watch": "vite build --watch --mode development",
    "build": "tsc && vite build && cp public/loader.js dist/ && cp docs/html-custom-data.json dist/",
    "build:cf": "vite build && vite build -c vite.config.legacy.ts && npm run build:config && cp public/loader.js dist/ && cp docs/html-custom-data.json dist/",
    "build:window": "tsc && vite build && copy public\\loader.js dist\\ && copy docs\\html-custom-data.json dist\\",
    "build:cf:window": "vite build && vite build -c vite.config.legacy.ts && npm run build:config && copy public\\loader.js dist\\ && copy docs\\html-custom-data.json dist\\",
    "build:config": "node scripts/build-config.js",
    "analytics:manifest": "UPDATE_ANALYTICS_MANIFEST=1 vitest run src/tests/utils/analyticsVocabulary.test.ts; vitest run src/tests/utils/analyticsVocabulary.test.ts",
    "build:dev": "vite build --mode development --watch",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:coverage": "vitest --coverage",
    "analyze": "cross-env ANALYZE=true npm run build",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate:display": "ts-node scripts/validate-display-config.ts",
    "docs": "typedoc && node scripts/docs-assets.mjs",
    "docs:serve": "node scripts/docs-serve.mjs --watch",
    "docs:check": "typedoc --treatWarningsAsErrors",
    "docs:version": "node scripts/docs-build-version.mjs",
    "docs:versions": "node scripts/docs-versions.mjs",
    "docs:publish": "node scripts/docs-publish.mjs",
    "docs:reference": "UPDATE_DOCS=1 vitest run src/tests/docs/",
    "docs:coverage": "node scripts/docs-coverage.mjs",
    "docs:coverage:update": "UPDATE_DOCS_BASELINE=1 node scripts/docs-coverage.mjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.5.3",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "decimal.js": "^10.6.0",
    "highlight.js": "^11.11.1",
    "intl-tel-input": "^25.11.3",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/dom": "^9.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^10.0.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "happy-dom": "^18.0.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.24.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.2",
    "vite": "^6.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ecommerce",
    "cart",
    "checkout",
    "nextcommerce",
    "typescript",
    "web-components",
    "progressive-enhancement"
  ],
  "author": "NextCommerce",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NextCommerceCo/campaign-cart.git"
  },
  "bugs": {
    "url": "https://github.com/NextCommerceCo/campaign-cart/issue"
  },
  "homepage": "https://github.com/NextCommerceCo/campaign-cart#readme"
}
