{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/tests/**",
    "**/*.state-manifest.ts",
    "**/*.manifest.ts"
  ],
  "tsconfig": "tsconfig.json",
  "name": "Campaign Cart SDK",
  "readme": "docs/.staged-home.md",
  "plugin": [
    "typedoc-plugin-mdn-links",
    "@clean-jsdoc-theme/typedoc"
  ],
  "outputs": [
    {
      "name": "clean-jsdoc-theme",
      "path": "docs/site/latest"
    }
  ],
  "cleanJsdocTheme": {
    "siteName": "Campaign Cart SDK",
    "docs": "docs/.staged",
    "docGroups": [
      "Start Here",
      "Building Pages",
      "Reference"
    ],
    "fonts": {
      "heading": "Inter",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "basePath": "/latest/",
    "customCssFile": "docs/assets/clean-theme.css",
    "customJsFile": "docs/assets/site.js",
    "favicon": "docs/assets/favicon.ico",
    "sectionOrder": [
      "Cart",
      "Campaign",
      "Shipping",
      "Coupons",
      "Upsells",
      "Checkout",
      "Orders",
      "Events",
      "Analytics",
      "Attribution",
      "Metadata",
      "URL Parameters",
      "Popups",
      "Utility",
      "Core"
    ],
    "footer": "<div class=\"border-t border-(--clean-border) bg-background py-6 text-sm text-muted-foreground\"><div class=\"mx-auto flex w-full max-w-screen-2xl items-center px-4\"><span>NEXT Commerce &copy; 2026</span></div></div>"
  },
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": [
    "source-order"
  ],
  "gitRevision": "main",
  "categorizeByGroup": false,
  "categoryOrder": [
    "Cart",
    "Campaign",
    "Shipping",
    "Coupons",
    "Upsells",
    "Checkout",
    "Orders",
    "Events",
    "Analytics",
    "Attribution",
    "Metadata",
    "URL Parameters",
    "Popups",
    "Utility",
    "Core",
    "*"
  ],
  "validation": {
    "invalidLink": true,
    "notExported": false,
    "notDocumented": false
  }
}
