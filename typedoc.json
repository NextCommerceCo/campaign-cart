{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/boot.ts"],
  "exclude": ["tests/**"],
  "tsconfig": "tsconfig.json",
  "name": "Campaign Cart SDK",
  "readme": "docs/.staged-home.md",
  "plugin": ["typedoc-plugin-mdn-links", "@clean-jsdoc-theme/typedoc"],
  "outputs": [
    {
      "name": "clean-jsdoc-theme",
      "path": "docs/site/latest"
    }
  ],
  "cleanJsdocTheme": {
    "siteName": "Campaign Cart SDK",
    "docs": "docs/.staged",
    "docGroups": [
      "Start Here",
      "Building Pages",
      "Recipes",
      "Attribute Reference",
      "Event Reference",
      "Analytics Reference",
      "JavaScript API"
    ],
    "fonts": {
      "heading": "Inter",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "basePath": "/latest/",
    "customCssFile": "docs/assets/clean-theme.css",
    "customJsFile": "docs/assets/site.js",
    "favicon": "docs/assets/favicon.ico",
    "footer": "<div class=\"border-t border-(--clean-border) bg-background py-6 text-sm text-muted-foreground\"><div class=\"mx-auto flex w-full max-w-screen-2xl items-center px-4\"><span>NEXT Commerce &copy; 2026</span></div></div>"
  },
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": ["source-order"],
  "gitRevision": "main",
  "categorizeByGroup": false,
  "validation": {
    "invalidLink": true,
    "notExported": false,
    "notDocumented": false
  }
}
