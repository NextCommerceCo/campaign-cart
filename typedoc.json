{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/core",
    "src/state"
  ],
  "entryPointStrategy": "expand",
  "exclude": [
    "**/*.test.ts",
    "**/tests/**",
    "**/*.state-manifest.ts",
    "**/*.manifest.ts"
  ],
  "tsconfig": "tsconfig.json",
  "out": "docs/site",
  "name": "Campaign Cart SDK",
  "readme": "docs/site-home.md",
  "projectDocuments": [
    "src/features/**/guide/*.md",
    "src/features/**/guide/reference/*.md",
    "src/state/**/guide/*.md",
    "src/state/**/guide/reference/*.md",
    "src/core/guide/**/*.md",
    "docs/attribute-index.md",
    "docs/sdk-attributes.md"
  ],
  "searchInDocuments": true,
  "plugin": [
    "typedoc-plugin-mdn-links",
    "@boneskull/typedoc-plugin-mermaid",
    "typedoc-plugin-llms-txt"
  ],
  "ignoredHighlightLanguages": [
    "mermaid"
  ],
  "mermaidSource": "local",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "sort": [
    "source-order"
  ],
  "gitRevision": "main",
  "categorizeByGroup": false,
  "categoryOrder": [
    "Cart",
    "Campaign",
    "Shipping",
    "Coupons",
    "Upsells",
    "Events",
    "Analytics",
    "Attribution",
    "Metadata",
    "URL Parameters",
    "Popups",
    "Utility",
    "Core",
    "*"
  ],
  "validation": {
    "invalidLink": true,
    "notExported": false,
    "notDocumented": false
  },
  "customCss": "docs/assets/typedoc.css",
  "customJs": "docs/assets/site.js"
}
